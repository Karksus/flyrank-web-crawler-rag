# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/company_rag_bot
SQL_ECHO=False

# Application Settings
SECRET_KEY=your-secret-key-change-in-production
APP_NAME=Company Portal RAG Chatbot
DEBUG=True

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Configuration
# Options: ollama, openrouter, openai, anthropic
LLM_PROVIDER=ollama
# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=300
# OpenRouter (Free models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODELS=recursive/flint-v1.0:free,nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free,google/gemma-4-31b-it:free
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_TIMEOUT=300
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1200
OPENAI_TIMEOUT=300
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_MAX_TOKENS=1200
ANTHROPIC_TIMEOUT=300

# Embeddings Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Crawling Configuration
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=2
CRAWL_DELAY=1.0
CRAWL_TIMEOUT=30
CRAWL_USER_AGENT=CompanyRAGBot/1.0 (+https://github.com/yourusername/flyrank-web-crawler-rag)
RESPECT_ROBOTS_TXT=True

# RAG Configuration
RAG_TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=75

# Caching Configuration
CACHE_TTL_SECONDS=300

# Public Opinion Check
PUBLIC_OPINION_ENABLED=True
PUBLIC_OPINION_TIMEOUT=20
PUBLIC_OPINION_MAX_ITEMS=12
PUBLIC_OPINION_CACHE_TTL_SECONDS=1800
PUBLIC_OPINION_USER_AGENT=CompanyRAGBot/1.0 (+public-opinion-check)
PUBLIC_OPINION_LLM_MODELS=poolside/laguna-s-2.1:free,cohere/north-mini-code:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Server Configuration
HOST=0.0.0.0
PORT=8000
